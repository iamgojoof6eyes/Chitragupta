# Chitragupta AI Backend Configuration

# AI Provider options: auto, nvidia, gemini, heuristic
AI_PROVIDER=auto

# NVIDIA Build / NIM API Key (e.g. nvapi-...)
# Get a free key at: https://build.nvidia.com
NVIDIA_API_KEY=

# Google Gemini API Key (e.g. AIzaSy...)
# Get a free key at: https://aistudio.google.com
GEMINI_API_KEY=

# Custom model identifier (optional)
# e.g. for NVIDIA: meta/llama-3.1-70b-instruct
# e.g. for Gemini: gemini-1.5-flash
AI_MODEL=
